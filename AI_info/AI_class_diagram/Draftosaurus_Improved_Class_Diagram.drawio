as="geometry"/></mxCell><mxCell id="inh1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#aaaaaa;fontColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="pen" target="meadow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inh2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#aaaaaa;fontColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="pen" target="prairie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inh3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#aaaaaa;fontColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="pen" target="woody"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inh4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#aaaaaa;fontColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="pen" target="king"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inh5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#aaaaaa;fontColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="pen" target="island"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note1" value="<b>Design notes</b><hr>Pen subclasses own placement + scoring rules.<br>ComputerPlayer inherits Player and chooses using a simple heuristic.<br>Game coordinates 4 rounds / 3 placements per round for the 2-player mode.<br>Each Player owns one Board (Zoo), so the two players have separate zoos.<br>Winner comparison includes points, then fewest T-Rexes for a tie.DinosaurBag owns creation, shuffle and drawing of individual Dinosaur objects.<br>GameForm handles user interaction; game classes contain rules." style="shape=note;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#d0d0d0;fontColor=#ffffff;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="1170" width="690" height="150" as="geometry"/></mxCell></root></mxGraphModel>